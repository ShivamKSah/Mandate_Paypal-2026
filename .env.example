# Copy to .env. Never commit real provider credentials.
DATABASE_URL=postgresql+psycopg://mandate:mandate_local_only@127.0.0.1:55432/mandate
POSTGRES_PASSWORD=mandate_local_only
APP_ENV=development
COOKIE_SECURE=false
# Built frontend and API share this origin. Use :5173 only for the Vite development UI.
PUBLIC_BASE_URL=http://localhost:8000
# Optional locally; required for APP_ENV=production unless PUBLIC_DEMO=true. Generate a unique random secret, 32+ characters.
APP_ACCESS_KEY=
# Set PUBLIC_DEMO=true only for an intentionally public sandbox demo (isolated per-visitor sessions, daily LLM cap).
PUBLIC_DEMO=false
DAILY_LLM_RUN_LIMIT=50
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
GROQ_API_KEY=
# Optional model override. Defaults to this GroqCloud model.
GROQ_MODEL=openai/gpt-oss-20b
# Required when storing or charging PayPal vault grants. Generate with Fernet.generate_key().
VAULT_ENCRYPTION_KEY=
# Label-only flag: set true only after live PayPal Sandbox end-to-end vault verification passes.
VAULT_AUTONOMY_VERIFIED=false
